#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# b3 — Blender + Three.js Bridge CLI
#
# Launches Blender with the B3 add-on (__init__.py), optionally opening a
# .blend file, setting the WebSocket port, or running headless.
#
# Usage:
#   ./b3                        Launch Blender with the add-on (GUI)
#   ./b3 myfile.blend           Open a specific .blend file
#   ./b3 --headless             Run Blender in the background (no GUI)
#   ./b3 --port 9000            Override the default WebSocket port
#   ./b3 --background           Render / script mode (Blender --background)
#   ./b3 --python script.py     Run an extra Python script after the add-on
#   ./b3 --help                 Show this help
#
# Requirements:
#   - Blender 5.2+ installed in /Applications/Blender.app (macOS)
#     or available on PATH as 'blender' (Linux / custom installs)
# ---------------------------------------------------------------------------

set -euo pipefail

# --- Resolve paths -----------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ADDON_INIT="$SCRIPT_DIR/__init__.py"

if [[ ! -f "$ADDON_INIT" ]]; then
    echo "ERROR: __init__.py not found at $ADDON_INIT"
    exit 1
fi

# --- Locate Blender ----------------------------------------------------------
BLENDER=""

# 1. User-specified via B3_BLENDER env var
if [[ -n "${B3_BLENDER:-}" ]] && command -v "$B3_BLENDER" &>/dev/null; then
    BLENDER="$B3_BLENDER"
fi

# 2. macOS default install
if [[ -z "$BLENDER" ]] && [[ -x "/Applications/Blender.app/Contents/MacOS/Blender" ]]; then
    BLENDER="/Applications/Blender.app/Contents/MacOS/Blender"
fi

# 3. On PATH
if [[ -z "$BLENDER" ]] && command -v blender &>/dev/null; then
    BLENDER="$(command -v blender)"
fi

if [[ -z "$BLENDER" ]]; then
    echo "ERROR: Blender not found."
    echo "  Set B3_BLENDER=/path/to/blender or install Blender to /Applications."
    exit 1
fi

echo "→ Blender : $BLENDER"
echo "→ Add-on  : $ADDON_INIT"

# --- Defaults ----------------------------------------------------------------
PORT="${B3_PORT:-8765}"
MODE="gui"
EXTRA_PYTHON=()
BLEND_FILE=""
BLENDER_ARGS=()

# --- Parse arguments ---------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            head -16 "$0" | tail -14
            echo ""
            echo "Environment variables:"
            echo "  B3_BLENDER   path to the Blender executable"
            echo "  B3_PORT      default WebSocket port (default: 8765)"
            exit 0
            ;;
        --headless)
            MODE="headless"
            shift
            ;;
        --background|-b)
            MODE="background"
            shift
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --python)
            EXTRA_PYTHON+=("$2")
            shift 2
            ;;
        --)
            BLENDER_ARGS+=("${@:2}")
            shift $#
            ;;
        -*)
            # Pass unknown flags through to Blender
            BLENDER_ARGS+=("$1")
            shift
            ;;
        *.blend)
            BLEND_FILE="$1"
            shift
            ;;
        *)
            echo "ERROR: Unknown argument: $1"
            echo "  Use --help for usage."
            exit 1
            ;;
    esac
done

# --- Build the Blender command -----------------------------------------------
# We run __init__.py as a script (--python), which registers the add-on and
# auto-starts the WebSocket server.  The script's own __name__ == "__main__"
# block handles registration.
#
# We also set the port via a small inline script so the add-on picks it up
# before auto-starting.

PORT_SCRIPT="import bpy; bpy.context.scene.blendertalk_port = ${PORT}"

# Combine: first set the port, then load the add-on
COMBINED_PYTHON=$(mktemp /tmp/b3_init_XXXXXX.py)
trap "rm -f '$COMBINED_PYTHON'" EXIT

cat > "$COMBINED_PYTHON" << PYEOF
# b3 launch script — generated by b3 CLI

# Override the default port before the add-on auto-starts
import bpy
bpy.context.scene.blendertalk_port = ${PORT}

# Run the add-on (it will register and auto-start the server)
exec(open("${ADDON_INIT}").read())
PYEOF

CMD=("$BLENDER")

case "$MODE" in
    gui)
        # Normal GUI mode — __init__.py is passed via --python
        if [[ -n "$BLEND_FILE" ]]; then
            CMD+=("$BLEND_FILE")
        fi
        CMD+=(--python "$COMBINED_PYTHON")
        ;;
    headless)
        # Headless mode — no GUI, Blender runs the add-on then waits
        # Use --python-expr to keep the process alive
        if [[ -n "$BLEND_FILE" ]]; then
            CMD+=("$BLEND_FILE")
        fi
        CMD+=(--python "$COMBINED_PYTHON")
        CMD+=(--python-expr "import bpy; print('[b3] Headless — server running. Press Ctrl+C to stop.'); bpy.app.timers.register(lambda: 60.0)")  # keep-alive
        ;;
    background)
        # Background mode — for rendering / batch processing
        CMD+=(--background)
        if [[ -n "$BLEND_FILE" ]]; then
            CMD+=("$BLEND_FILE")
        fi
        CMD+=(--python "$COMBINED_PYTHON")
        ;;
esac

# Append any extra --python scripts
if [[ ${#EXTRA_PYTHON[@]} -gt 0 ]]; then
    for script in "${EXTRA_PYTHON[@]}"; do
        CMD+=(--python "$script")
    done
fi

# Append any passthrough Blender args
if [[ ${#BLENDER_ARGS[@]} -gt 0 ]]; then
    CMD+=("${BLENDER_ARGS[@]}")
fi

# --- Launch ------------------------------------------------------------------
echo "→ Port    : $PORT"
echo "→ Mode    : $MODE"
echo "→ Command : ${CMD[*]}"
echo ""

exec "${CMD[@]}"
